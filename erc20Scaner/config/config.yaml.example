# ERC20代币扫描器配置文件示例
# 复制此文件为 config.yaml 并根据实际情况修改配置

# 节点配置
node:
  url: "https://mainnet.bityuan.com/eth"
  grpc: "localhost:8802"
  symbol: "bty"

# 数据库配置
database:
  enabled: true
  dsn: "root:password@tcp(localhost:3306)/token_scanner?charset=utf8mb4&parseTime=True&loc=Local"

# es配置
es:
  enabled: false
  host: "http://localhost:9200/"
  prefix: "db01_"
  version: 7
  user: "elastic"
  password: "elastic"

# 扫描配置
scanner:
  start_block: 42399544
  end_block: -1
  # 为 true 时扫块不对 from/to 调链上 balanceOf，仅写入/更新 token_balances 占位行，余额由 balance_refresher 刷新（建议同时启用 balance_refresher）
  skip_inline_balance_update: false

# 定时用链上 balanceOf 校准 token_balances（仅更新 balance 与 last_updated_at，不覆盖 last_tx_*）
balance_refresher:
  enabled: false
  interval: "1h"       # 调度周期，如 30m、1h；未配置时程序默认亦为 1h
  batch_size: 50       # 每轮最多刷新行数，<=0 时默认 50
  concurrency: 5         # 并发 RPC 上限，<=0 时默认 5
  min_age: ""            # 可选，如 "30s"：只刷新超过该时间未更新的行；空字符串表示不限制

rpc:
  port: "8080"

# 日志配置
log:
  level: "info"
  file: "./logs/app.log"
  max_size: 100      # 可选，默认 100
  max_backups: 5     # 可选，默认 5
  max_age: 30        # 可选，默认 30
